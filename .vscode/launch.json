{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "finue.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "env": {
        "DATABASE_URL": "sqlite:///data/dev.db",
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
